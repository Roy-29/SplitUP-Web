# Turso Database Configuration
# Obtain your Database URL and Auth Token from the Turso CLI (turso db show <db-name> / turso db tokens create <db-name>) or Turso Web Dashboard.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=

# Google OAuth Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web application)
VITE_GOOGLE_CLIENT_ID=
